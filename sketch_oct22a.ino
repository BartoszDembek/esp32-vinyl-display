void initMic() {
  i2s_config_t i2s_config = {
    .mode = (i2s_mode_t)(I2S_MODE_MASTER | I2S_MODE_RX),
    .sample_rate = 16000,
    .bits_per_sample = I2S_BITS_PER_SAMPLE_16BIT,
    .channel_format = I2S_CHANNEL_FMT_ONLY_LEFT,
    .communication_format = I2S_COMM_FORMAT_STAND_I2S,
    .intr_alloc_flags = ESP_INTR_FLAG_LEVEL1,
    .dma_buf_count = 8,
    .dma_buf_len = 64,
    .use_apll = false,
    .tx_desc_auto_clear = false,
    .fixed_mclk = 0
  };

  i2s_pin_config_t pin_config = {
    .bck_io_num = I2S_SCK,
    .ws_io_num = I2S_WS,
    .data_out_num = I2S_PIN_NO_CHANGE,
    .data_in_num = I2S_SD
  };

  i2s_driver_install(I2S_NUM_0, &i2s_config, 0, NULL);
  i2s_set_pin(I2S_NUM_0, &pin_config);
  i2s_zero_dma_buffer(I2S_NUM_0);
}

void drawScreen(const char* title, const char* subtitle = "") {
  display.setFullWindow();
  display.firstPage();
  do {
    display.fillScreen(GxEPD_WHITE);
    display.setTextColor(GxEPD_BLACK);
    display.setFont(&FreeMonoBold18pt7b);
    display.setCursor(15, 70);
    display.print(title);

    if (subtitle && subtitle[0] != '\0') {
      display.setFont(&FreeMonoBold12pt7b);
      display.setCursor(15, 110);
      display.print(subtitle);
    }
  } while (display.nextPage());
  display.hibernate();
}

void setState(State newState, SongInfo info = SongInfo()) {
  currentState = newState;
  switch (currentState) {
    case STATE_START:        drawScreen_4(); break;
    case STATE_CONNECTING:   drawScreen_2(); break;
    case STATE_RECORDING:    drawScreen_3(); break;
    case STATE_RECOGNIZING:  drawScreen_5(); break;
    case STATE_RESULT:
      if (info.found) {
        drawScreen_1(info);
      } else if (info.networkError) {
        drawScreen_7();
      } else if (info.micError) {
        drawScreen_8();
      } else {
        drawScreen_6();
      }
      break;
    case STATE_ERROR: drawScreen("Blad"); break;
  }
}

bool recordAudio() {
  setState(STATE_RECORDING);
  if (!audioBuffer) audioBuffer = (int16_t*)ps_malloc(totalSamples * sizeof(int16_t));
  if (!audioBuffer) {
    Serial.println("Brak PSRAM!");
    return false;
  }

  Serial.println("Nagrywam...");
  size_t bytesRead;
  int zeroCount = 0;
  int validSamples = 0;

  for (int i = 0; i < totalSamples; i++) {
    esp_err_t err = i2s_read(I2S_NUM_0, &audioBuffer[i], sizeof(int16_t), &bytesRead, pdMS_TO_TICKS(100));
    if (err != ESP_OK || bytesRead == 0) {
      zeroCount++;
      audioBuffer[i] = 0;
    } else {
      validSamples++;
      if (audioBuffer[i] == 0) zeroCount++;
    }
  }
  if (validSamples < totalSamples / 4 || zeroCount > totalSamples * 0.9) {
    Serial.println("Blad mikrofonu - brak danych z I2S");
    return false;   // sygnał błędu
  }
  Serial.println("Nagrane.");
  return true;
}

SongInfo recognizeWithAudd() {
  setState(STATE_RECOGNIZING);

  SongInfo info;

  String boundary = "----ESP32Boundary";
  uint32_t dataSize = totalSamples * 2;

  uint8_t wavHeader[44];
  memcpy(wavHeader, "RIFF", 4);
  uint32_t fileSize = 36 + dataSize;
  memcpy(wavHeader + 4, &fileSize, 4);
  memcpy(wavHeader + 8, "WAVEfmt ", 8);
  uint32_t fmtSize = 16;
  memcpy(wavHeader + 16, &fmtSize, 4);
  uint16_t audioFormat = 1;
  memcpy(wavHeader + 20, &audioFormat, 2);
  uint16_t channels = 1;
  memcpy(wavHeader + 22, &channels, 2);
  uint32_t sr = SAMPLE_RATE;
  memcpy(wavHeader + 24, &sr, 4);
  uint32_t byteRate = SAMPLE_RATE * 2;
  memcpy(wavHeader + 28, &byteRate, 4);
  uint16_t blockAlign = 2;
  memcpy(wavHeader + 32, &blockAlign, 2);
  uint16_t bits = 16;
  memcpy(wavHeader + 34, &bits, 2);
  memcpy(wavHeader + 36, "data", 4);
  memcpy(wavHeader + 40, &dataSize, 4);

  String head = "--" + boundary + "\r\n"
                "Content-Disposition: form-data; name=\"api_token\"\r\n\r\n" +
                String(AUDD_TOKEN) + "\r\n"
                "--" + boundary + "\r\n"
                "Content-Disposition: form-data; name=\"file\"; filename=\"audio.wav\"\r\n"
                "Content-Type: audio/wav\r\n\r\n";

  String tail = "\r\n--" + boundary + "--\r\n";
  int contentLength = head.length() + 44 + dataSize + tail.length();

  WiFiClientSecure client;
  client.setInsecure();

  if (!client.connect("api.audd.io", 443)) {
    info.networkError = true;
    info.title = "Blad sieci";
    return info;
  }

  client.print("POST / HTTP/1.1\r\n");
  client.print("Host: api.audd.io\r\n");
  client.print("Content-Type: multipart/form-data; boundary=" + boundary + "\r\n");
  client.print("Content-Length: " + String(contentLength) + "\r\n");
  client.print("Connection: close\r\n\r\n");
  client.print(head);
  client.write(wavHeader, 44);
  client.write((uint8_t*)audioBuffer, dataSize);
  client.print(tail);

  String response = "";
  unsigned long timeout = millis();
  while (client.connected() && millis() - timeout < 15000) {
    while (client.available()) {
      response += (char)client.read();
      timeout = millis();
    }
  }
  client.stop();

  if (response.length() == 0) {
    info.networkError = true;
    info.title = "Blad sieci";
    return info;
  }

  // Prosty parsing JSON
  int titleStart = response.indexOf("\"title\":\"");
  int artistStart = response.indexOf("\"artist\":\"");
  int albumStart = response.indexOf("\"album\":\"");

  if (titleStart == -1) {
    info.title = "Nie rozpoznano";
    return info;
  }

  auto extract = [&](int start, int offset) -> String {
    if (start == -1) return "";
    start += offset;
    int end = response.indexOf("\"", start);
    if (end == -1) return "";
    return response.substring(start, end);
  };

  info.title  = extract(titleStart, 9);
  info.artist = extract(artistStart, 10);
  info.album  = extract(albumStart, 9);
  info.found  = true;

  return info;
}


void setup() {
  Serial.begin(115200);
  delay(500);

  debug_value.title  = "Test";
  debug_value.artist = "Test";
  debug_value.album  = "test";
  debug_value.found  = true;

  SPI.begin(12, -1, 11, EPD_CS);
  display.init(115200, true, 2, false);
  display.setRotation(0);

  setState(STATE_START);
  delay(1800);
  setState(STATE_CONNECTING);

  WiFiManager wm;
  bool ok = wm.autoConnect("ESP32-Setup");

  if (ok) {
    initMic();
    Serial.println("IP: " + WiFi.localIP().toString());
    setState(STATE_CONNECTED);

    // Od razu pierwsze nagranie
    if (recordAudio()) {
      if(!debug){
        SongInfo result = recognizeWithAudd();
        setState(STATE_RESULT, result);
      }
      else{
        SongInfo result = debug_value;
        setState(STATE_RESULT, result);
      }
    } else {
      SongInfo err;
      err.micError = true;
      setState(STATE_RESULT, err);
    }
    lastRecordTime = millis();
  } else {
    setState(STATE_ERROR);
    delay(3000);
    ESP.restart();
  }
}

void loop() {
  if (millis() - lastRecordTime >= RECORD_INTERVAL) {
    if (recordAudio()) {
      if(!debug){
        SongInfo result = recognizeWithAudd();
        setState(STATE_RESULT, result);
        Serial.println(result.title + " - " + result.artist);
      }
      else{
        SongInfo result = debug_value;
        setState(STATE_RESULT, result);
      }
    }
    lastRecordTime = millis();
  }
}