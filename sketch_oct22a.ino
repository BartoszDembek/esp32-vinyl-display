void drawCenteredText(const String& text, int y, int textSize, int maxWidth) {
  display.setTextSize(textSize);
  display.setFont(&Petme8x8);

  String toDraw = text;

  // Obcinanie z "..."
  int16_t x1, y1;
  uint16_t w, h;
  display.getTextBounds(toDraw, 0, 0, &x1, &y1, &w, &h);

  while (w > maxWidth && toDraw.length() > 3) {
    toDraw = toDraw.substring(0, toDraw.length() - 1);
    display.getTextBounds(toDraw + "...", 0, 0, &x1, &y1, &w, &h);
  }
  if (toDraw != text) {
    toDraw += "...";
  }

  // Wyśrodkowanie
  display.getTextBounds(toDraw, 0, 0, &x1, &y1, &w, &h);
  int x = (display.width() - w) / 2;
  if (x < 0) x = 0;

  display.setCursor(x, y);
  display.print(toDraw);
}

