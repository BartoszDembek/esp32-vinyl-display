void drawScreen_1(SongInfo song) {
    display.fillScreen(GxEPD_WHITE);
    int maxWidth = display.width() - 20;
    // Artist Name
    display.setTextColor(GxEPD_BLACK);
    display.setTextSize(2);
    display.setTextWrap(false);
    display.setFont(&Petme8x8);
    drawCenteredText(song.artist, 141, 2, maxWidth);
    // Song Title
    drawCenteredText(song.title, 102, 3, maxWidth);
    // Album Name
    drawCenteredText(song.album, 176, 2, maxWidth);
    // streamline-music-album-cd-disk-playlist--music-audio.png
    display.drawBitmap(156, 184, image_streamline_music_album_cd_disk_playlist__music_audio_png_bits, 88, 88, GxEPD_BLACK);
    display.display();
}


